# A1 Mobi local/deployment configuration — never commit real secrets.
DATABASE_URL=postgresql://a1mobi:change-me@127.0.0.1:5432/a1mobi?schema=public
APP_ORIGIN=http://127.0.0.1:3000

# Account/security
A1_MOBI_BOOTSTRAP_SECRET=
A1_MOBI_PUBLIC_TRIAL_ENABLED=0
A1_MOBI_ENFORCE_ENTITLEMENTS=0
A1_SHARED_SERVICES_REQUIRED=0
A1_MOBI_MFA_ENCRYPTION_KEY=
A1_MOBI_RECOVERY_WEBHOOK_URL=
A1_MOBI_RECOVERY_WEBHOOK_SECRET=
# First-party Hostinger account-recovery delivery: HTTPS APP_ORIGIN required.
# Set webhook URL to https://<staging-host>/api/internal/recovery-delivery.
# SMTP 465 uses implicit TLS; do not store mailbox passwords in this file or GitHub.
# Put SMTP_PASSWORD and RECOVERY_WEBHOOK_SECRET in the deployment's private secrets store.
A1_MOBI_SMTP_HOST=smtp.hostinger.com
A1_MOBI_SMTP_PORT=465
A1_MOBI_SMTP_USER=hi@a1medianet.com
A1_MOBI_SMTP_PASSWORD=
# Official sender for A1 Mobi account-recovery messages (not tenant storefront contact).
A1_MOBI_SMTP_FROM=hi@a1medianet.com

# A1 Billing Core (server-to-server)
A1_BILLING_CORE_URL=
A1_BILLING_SERVICE_TOKEN=
A1_BILLING_PORTAL_URL=

# A1 Pulse Core — use full ingest endpoints supplied by the shared service.
A1_PULSE_HEARTBEAT_URL=
A1_PULSE_ERROR_URL=
A1_PULSE_SERVICE_TOKEN=
A1_TELEMETRY_HASH_SALT=

# A1 Assist — full server endpoint supplied by the shared service.
A1_ASSIST_ENDPOINT=
A1_ASSIST_SERVICE_TOKEN=

# Version/update contract
A1_APP_VERSION=0.1.0
A1_BUILD_SHA=local
A1_RELEASE_CHANNEL=pilot
A1_LATEST_VERSION=0.1.0
A1_MINIMUM_SUPPORTED_VERSION=0.1.0
