# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Thaghr private runtime, never version control
/.local/

# Dedicated C-LIVE-01 local build output
/.next-c-live/

# Isolated local C-LIVE-02 preview build
/.next-c-live02/

# Local C-LIVE-02 settlement verification only
/.next-c-live02-final/

# C-LIVE-02 visual UAT preview isolated on Thaghr
/.next-c-live02-ui/

# Isolated C-14 preview build - never commit generated output
/.next-c14/

# Isolated C15 ABC visual UAT build
/.next-c15/

# A owner-reference isolated visual review
/.next-a-ref/

# B customer-journey isolated preview
/.next-b-review/
