generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  defaultLocale String       @default("ar")
  baseCurrency String        @default("USD")
  branches     Branch[]
  users        User[]
  roles        Role[]
  featureFlags FeatureFlag[]
  auditEvents  AuditEvent[]
  categories   Category[]
  products     Product[]
  barcodes     Barcode[]
  manufacturers Manufacturer[]
  deviceFamilies DeviceFamily[]
  deviceModels DeviceModel[]
  deviceVariants DeviceVariant[]
  serializedDevices SerializedDevice[]
  suppliers    Supplier[]
  purchases    Purchase[]
  stockLocations StockLocation[]
  stockMovements StockMovement[]
  stockCounts  StockCount[]
  sales        Sale[]
  payments     Payment[]
  invoices     Invoice[]
  returns      SaleReturn[]
  exchanges    Exchange[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users     User[]
  auditEvents AuditEvent[]
  purchases Purchase[]
  stockLocations StockLocation[]
  stockMovements StockMovement[]
  stockCounts StockCount[]
  sales Sale[]
  payments Payment[]
  invoices Invoice[]
  returns SaleReturn[]
  exchanges Exchange[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}
model User {
  id           String      @id @default(cuid())
  tenantId     String
  branchId     String?
  email        String
  displayName  String
  passwordHash String
  locale       String      @default("ar")
  isActive     Boolean     @default(true)
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles    UserRole[]
  sessions     Session[]
  auditEvents  AuditEvent[] @relation("AuditActor")
  sales        Sale[] @relation("SaleActor")
  approvedSaleLines SaleLine[] @relation("PriceOverrideActor")
  processedReturns SaleReturn[] @relation("ReturnActor")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId, branchId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  code        String
  name        String
  isSystem    Boolean          @default(false)
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}
model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}
model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  branchId   String?
  actorId    String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  occurredAt DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor      User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorId, occurredAt])
}


enum ProductType {
  DEVICE
  PART
  ACCESSORY
  SERVICE
}

enum SerializedDeviceStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  IN_REPAIR
  QUARANTINED
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE
  RETURN
  TRANSFER
  REPAIR_USE
  ADJUSTMENT
  COUNT_VARIANCE
}

enum StockCountStatus {
  DRAFT
  COUNTING
  POSTED
  CANCELLED
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String
  code      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Product {
  id             String      @id @default(cuid())
  tenantId       String
  categoryId     String
  sku            String
  nameAr         String
  nameEn         String
  type           ProductType
  isSerialized   Boolean     @default(false)
  costAmount     Decimal     @default(0) @db.Decimal(18, 4)
  basePrice      Decimal     @default(0) @db.Decimal(18, 4)
  minimumPrice   Decimal     @default(0) @db.Decimal(18, 4)
  lowStockLevel  Decimal     @default(0) @db.Decimal(18, 3)
  isActive       Boolean     @default(true)
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  barcodes       Barcode[]
  serializedDevices SerializedDevice[]
  purchaseLines  PurchaseLine[]
  stockMovements StockMovement[]
  countLines     StockCountLine[]
  compatibilities ProductCompatibility[]
  saleLines      SaleLine[]
  returnLines    SaleReturnLine[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId, type])
}

model Barcode {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  value      String
  isInternal Boolean  @default(false)
  isPrimary  Boolean  @default(false)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([tenantId, value])
  @@index([tenantId, productId])
}

model Manufacturer {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  families  DeviceFamily[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model DeviceFamily {
  id             String       @id @default(cuid())
  tenantId       String
  manufacturerId String
  name           String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  models         DeviceModel[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, manufacturerId, name])
}

model DeviceModel {
  id        String          @id @default(cuid())
  tenantId  String
  familyId  String
  name      String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  family    DeviceFamily    @relation(fields: [familyId], references: [id], onDelete: Restrict)
  variants  DeviceVariant[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([tenantId, familyId, name])
}

model DeviceVariant {
  id             String       @id @default(cuid())
  tenantId       String
  modelId        String
  name           String
  storage        String?
  color          String?
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  model          DeviceModel  @relation(fields: [modelId], references: [id], onDelete: Restrict)
  devices        SerializedDevice[]
  compatibleParts ProductCompatibility[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, modelId, name])
}

model ProductCompatibility {
  productId       String
  deviceVariantId String
  source          String   @default("manual")
  confidence      Decimal? @db.Decimal(5, 4)
  notes           String?
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  deviceVariant   DeviceVariant @relation(fields: [deviceVariantId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@id([productId, deviceVariantId])
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchases Purchase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Purchase {
  id          String         @id @default(cuid())
  tenantId    String
  branchId    String
  supplierId  String
  reference   String
  status      PurchaseStatus @default(DRAFT)
  currency    String         @default("USD")
  exchangeRate Decimal       @default(1) @db.Decimal(18, 6)
  receivedAt  DateTime?
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines       PurchaseLine[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, reference])
  @@index([tenantId, branchId, status])
}

model PurchaseLine {
  id           String   @id @default(cuid())
  purchaseId   String
  productId    String
  quantity     Decimal  @db.Decimal(18, 3)
  unitCost     Decimal  @db.Decimal(18, 4)
  purchase     Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([purchaseId, productId])
}

model StockLocation {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String
  code        String
  name        String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  devices     SerializedDevice[]
  outbound    StockMovement[] @relation("StockFrom")
  inbound     StockMovement[] @relation("StockTo")
  counts      StockCount[]
  saleLines    SaleLine[]
  returnLines  SaleReturnLine[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
}

model SerializedDevice {
  id              String                 @id @default(cuid())
  tenantId        String
  productId       String
  variantId       String
  stockLocationId String?
  imei            String?
  serialNumber    String?
  status          SerializedDeviceStatus @default(IN_STOCK)
  unitCost        Decimal                @db.Decimal(18, 4)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product         Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         DeviceVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockLocation   StockLocation?         @relation(fields: [stockLocationId], references: [id], onDelete: SetNull)
  movements       StockMovement[]
  saleLines       SaleLine[]
  returnLines     SaleReturnLine[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([tenantId, imei])
  @@unique([tenantId, serialNumber])
  @@index([tenantId, productId, status])
}

model StockMovement {
  id                 String            @id @default(cuid())
  tenantId           String
  branchId           String
  productId          String
  serializedDeviceId String?
  fromLocationId     String?
  toLocationId       String?
  type               StockMovementType
  quantity           Decimal           @db.Decimal(18, 3)
  unitCost           Decimal?          @db.Decimal(18, 4)
  reason             String?
  referenceType      String?
  referenceId        String?
  idempotencyKey     String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  serializedDevice   SerializedDevice? @relation(fields: [serializedDeviceId], references: [id], onDelete: Restrict)
  fromLocation       StockLocation?    @relation("StockFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation         StockLocation?    @relation("StockTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  occurredAt         DateTime          @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, productId, occurredAt])
  @@index([tenantId, serializedDeviceId])
}

model StockCount {
  id          String           @id @default(cuid())
  tenantId    String
  branchId    String
  locationId  String
  status      StockCountStatus @default(DRAFT)
  startedAt   DateTime         @default(now())
  postedAt    DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location    StockLocation    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  lines       StockCountLine[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, branchId, status])
}

model StockCountLine {
  id          String     @id @default(cuid())
  stockCountId String
  productId   String
  expectedQty Decimal    @db.Decimal(18, 3)
  countedQty  Decimal    @db.Decimal(18, 3)
  reason      String?
  stockCount  StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())

  @@unique([stockCountId, productId])
}

enum SaleStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  COMPLETED
  PARTIALLY_RETURNED
  RETURNED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  POSTED
  REVERSED
}

enum InvoiceStatus {
  ISSUED
  VOIDED
  CREDITED
}

enum ReturnStatus {
  POSTED
  REVERSED
}

enum ExchangeStatus {
  COMPLETED
  REVERSED
}

model Sale {
  id             String       @id @default(cuid())
  tenantId       String
  branchId       String
  actorId        String
  customerId     String?
  number         String
  status         SaleStatus   @default(DRAFT)
  subtotal       Decimal      @db.Decimal(18, 4)
  discountTotal  Decimal      @default(0) @db.Decimal(18, 4)
  total          Decimal      @db.Decimal(18, 4)
  paidTotal      Decimal      @default(0) @db.Decimal(18, 4)
  balanceDue     Decimal      @default(0) @db.Decimal(18, 4)
  baseCurrency   String       @default("USD")
  idempotencyKey String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor          User         @relation("SaleActor", fields: [actorId], references: [id], onDelete: Restrict)
  lines          SaleLine[]
  payments       Payment[]
  invoice        Invoice?
  returns        SaleReturn[]
  exchangeSales  Exchange[]   @relation("ExchangeNewSale")
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, customerId])
}

model SaleLine {
  id                    String            @id @default(cuid())
  saleId                String
  productId             String
  stockLocationId       String
  serializedDeviceId    String?
  quantity              Decimal           @db.Decimal(18, 3)
  baseUnitPrice         Decimal           @db.Decimal(18, 4)
  minimumUnitPrice      Decimal           @db.Decimal(18, 4)
  finalUnitPrice        Decimal           @db.Decimal(18, 4)
  unitCost              Decimal           @db.Decimal(18, 4)
  lineTotal             Decimal           @db.Decimal(18, 4)
  priceOverrideActorId  String?
  priceOverrideReason   String?
  sale                  Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product               Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockLocation         StockLocation     @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  serializedDevice      SerializedDevice? @relation(fields: [serializedDeviceId], references: [id], onDelete: Restrict)
  priceOverrideActor    User?             @relation("PriceOverrideActor", fields: [priceOverrideActorId], references: [id], onDelete: Restrict)
  returnLines           SaleReturnLine[]
  createdAt             DateTime          @default(now())

  @@index([saleId, productId])
  @@index([serializedDeviceId])
}

model Payment {
  id           String        @id @default(cuid())
  tenantId     String
  branchId     String
  saleId       String
  method       PaymentMethod
  currency     String
  amount       Decimal       @db.Decimal(18, 4)
  exchangeRate Decimal       @db.Decimal(18, 6)
  baseAmount   Decimal       @db.Decimal(18, 4)
  status       PaymentStatus @default(POSTED)
  reference    String?
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  paidAt       DateTime      @default(now())

  @@index([tenantId, branchId, paidAt])
  @@index([saleId, status])
}

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  branchId   String
  saleId     String        @unique
  number     String
  status     InvoiceStatus @default(ISSUED)
  snapshot   Json
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale       Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  issuedAt   DateTime      @default(now())

  @@unique([tenantId, number])
}

model SaleReturn {
  id             String       @id @default(cuid())
  tenantId       String
  branchId       String
  saleId         String
  actorId        String
  number         String
  status         ReturnStatus @default(POSTED)
  reason         String
  refundBase     Decimal      @db.Decimal(18, 4)
  idempotencyKey String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale           Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  actor          User         @relation("ReturnActor", fields: [actorId], references: [id], onDelete: Restrict)
  lines          SaleReturnLine[]
  exchanges      Exchange[]
  occurredAt     DateTime     @default(now())

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId])
}

model SaleReturnLine {
  id                 String            @id @default(cuid())
  returnId           String
  originalSaleLineId String
  productId          String
  stockLocationId    String
  serializedDeviceId String?
  quantity           Decimal           @db.Decimal(18, 3)
  refundUnitPrice    Decimal           @db.Decimal(18, 4)
  lineTotal          Decimal           @db.Decimal(18, 4)
  saleReturn         SaleReturn        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  originalSaleLine   SaleLine          @relation(fields: [originalSaleLineId], references: [id], onDelete: Restrict)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockLocation      StockLocation     @relation(fields: [stockLocationId], references: [id], onDelete: Restrict)
  serializedDevice   SerializedDevice? @relation(fields: [serializedDeviceId], references: [id], onDelete: Restrict)

  @@index([returnId, productId])
}

model Exchange {
  id         String         @id @default(cuid())
  tenantId   String
  branchId   String
  returnId   String
  newSaleId  String
  status     ExchangeStatus @default(COMPLETED)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  saleReturn SaleReturn     @relation(fields: [returnId], references: [id], onDelete: Restrict)
  newSale    Sale           @relation("ExchangeNewSale", fields: [newSaleId], references: [id], onDelete: Restrict)
  occurredAt DateTime       @default(now())

  @@unique([returnId, newSaleId])
  @@index([tenantId, branchId, occurredAt])
}
